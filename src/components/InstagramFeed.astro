---
/**
 * InstagramFeed.astro
 * --------------------------------------------------------------------------
 * Static placeholder for the Instagram social feed.
 */
import { Image } from "astro:assets";
import SectionTitle from "./SectionTitle.astro";

import img1 from "../assets/images/Happy Group.jpg";
import img2 from "../assets/images/Smiling Girls.jpg";
import img3 from "../assets/images/Three Happy Guys.jpg";
import img4 from "../assets/images/Two Smiling Girls.jpg";

const posts = [
  { src: img1, alt: "Happy group enjoying drinks at Grogg's" },
  { src: img2, alt: "Friends smiling at the bar" },
  { src: img3, alt: "Three happy guys with their pints" },
  { src: img4, alt: "Two smiling girls enjoying the pub atmosphere" },
];
---

<section class="mx-auto max-w-7xl px-6 py-24 sm:px-8 lg:px-12">
  <div class="flex flex-col items-center gap-12">
    <div class="text-center">
        <SectionTitle subtitle="Join the conversation">
            Follow Us On Instagram
        </SectionTitle>
        <a 
            href="https://instagram.com" 
            target="_blank" 
            rel="noopener noreferrer"
            class="display-caps text-pub-green-light hover:text-white transition-colors duration-300 text-lg tracking-[0.2em] mt-2 inline-block"
        >
            @groggspub
        </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full">
      {posts.map((post) => (
        <a 
            href="#" 
            class="relative group aspect-square overflow-hidden rounded-lg border border-white/5"
        >
          <Image
            src={post.src}
            alt={post.alt}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
          />
          <div class="absolute inset-0 bg-pub-green/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
