---
/**
 * OurStory.astro
 * --------------------------------------------------------------------------
 * Content section explaining the pub's heritage and mission.
 */
import { Image } from "astro:assets";
import SectionTitle from "./SectionTitle.astro";
import storyImg from "../assets/images/Two Happy Girls.jpg";
---

<section class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:px-12">
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
    <!-- Text Content -->
    <div class="flex flex-col gap-6">
      <SectionTitle align="left" subtitle="A Legend in Clovis">
        Our Story
      </SectionTitle>
      
      <div class="font-body text-text-secondary text-lg leading-relaxed flex flex-col gap-4">
        <p>
          Founded on the principle that a pub is more than just a place to drink, 
          <strong>Grogg's Traditional Irish Pub</strong> was established to bring 
          the warmth and community of a classic Dublin "local" to the heart of 
          California's Central Valley.
        </p>
        <p>
          From our hand-picked Irish whiskeys to our traditional family recipes, 
          every detail is curated to provide an authentic experience. Whether 
          you're here for a quiet pint of the "black stuff" or a lively night 
          with friends, you're part of the Grogg's family.
        </p>
        <p>
          And if you happen to spot our resident Leprechaun mascot, be sure to 
          say hello — he's been known to bring a bit of luck to those who 
          appreciate a properly poured Guinness.
        </p>
      </div>

      <div class="mt-4 flex flex-col sm:flex-row gap-8 items-start sm:items-center border-t border-white/10 pt-8">
         <div class="flex flex-col">
            <span class="display-caps text-[#f5f82f] text-2xl font-bold">10+</span>
            <span class="text-text-muted text-sm uppercase tracking-wider">Years in Clovis</span>
         </div>
         <div class="flex flex-col">
            <span class="display-caps text-[#f5f82f] text-2xl font-bold">50+</span>
            <span class="text-text-muted text-sm uppercase tracking-wider">Whiskey Varieties</span>
         </div>
         <div class="flex flex-col">
            <span class="display-caps text-[#f5f82f] text-2xl font-bold">100%</span>
            <span class="text-text-muted text-sm uppercase tracking-wider">Authentic Craic</span>
         </div>
      </div>
    </div>

    <!-- Image / Visual -->
    <div class="relative group">
      <div class="absolute -inset-4 bg-pub-green/20 rounded-lg blur-2xl group-hover:bg-pub-green/30 transition-colors duration-500"></div>
      <div class="relative overflow-hidden rounded-lg shadow-2xl aspect-[4/5] border border-white/5">
        <Image
          src={storyImg}
          alt="Happy customers enjoying the Grogg's atmosphere"
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-wood-darker/80 to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6">
            <p class="display-caps text-[#f5f82f] text-sm tracking-widest bg-pub-green/90 px-4 py-2 inline-block rounded">
                Established 2012
            </p>
        </div>
      </div>
    </div>
  </div>
</section>
