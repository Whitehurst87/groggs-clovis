---
/**
 * MobileActionBar.astro
 * --------------------------------------------------------------------------
 * Sticky bottom bar visible on mobile only — the three highest-value actions:
 * Call · Directions · Menu
 *
 * Per Gemini's mobile UX mandate: "A sticky bottom action bar with the three
 * most important actions for a mobile user."
 *
 * Implemented in pure Astro/HTML+CSS — zero JavaScript.
 * Uses env(safe-area-inset-bottom) for notched phone compatibility.
 */
---

<nav
  class="fixed bottom-0 inset-x-0 z-40 flex md:hidden bg-wood-darker border-t border-pub-green/30 shadow-[0_-4px_24px_rgba(0,0,0,0.6)]"
  aria-label="Quick actions"
  style="padding-bottom: env(safe-area-inset-bottom, 0px);"
>
  <!-- Call -->
  <a
    href="tel:+15595551234"
    class="flex flex-1 flex-col items-center justify-center gap-1 py-3 text-white transition-colors hover:bg-pub-green/20 focus-visible:outline-none focus-visible:bg-pub-green/20"
    aria-label="Call Grogg's"
  >
    <!-- Phone icon (inline SVG for zero-JS, zero-import) -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="text-pub-green"
    >
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.33h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.9a16 16 0 0 0 6.06 6.06l.88-.88a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.09z"/>
    </svg>
    <span class="text-[10px] font-semibold tracking-widest uppercase text-text-secondary">Call</span>
  </a>

  <!-- Divider -->
  <div class="w-px bg-wood-mid self-stretch my-2" aria-hidden="true"></div>

  <!-- Directions -->
  <a
    href="https://maps.google.com/?q=Grogg%27s+Traditional+Irish+Pub+Clovis+CA"
    target="_blank"
    rel="noopener noreferrer"
    class="flex flex-1 flex-col items-center justify-center gap-1 py-3 text-white transition-colors hover:bg-pub-green/20 focus-visible:outline-none focus-visible:bg-pub-green/20"
    aria-label="Get directions to Grogg's"
  >
    <!-- Map pin icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="text-pub-green"
    >
      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
      <circle cx="12" cy="10" r="3"/>
    </svg>
    <span class="text-[10px] font-semibold tracking-widest uppercase text-text-secondary">Directions</span>
  </a>

  <!-- Divider -->
  <div class="w-px bg-wood-mid self-stretch my-2" aria-hidden="true"></div>

  <!-- Menu -->
  <a
    href="/menu"
    class="flex flex-1 flex-col items-center justify-center gap-1 py-3 text-white transition-colors hover:bg-pub-green/20 focus-visible:outline-none focus-visible:bg-pub-green/20"
    aria-label="View our menu"
  >
    <!-- Utensils icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="text-pub-green"
    >
      <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
      <path d="M7 2v20"/>
      <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
    </svg>
    <span class="text-[10px] font-semibold tracking-widest uppercase text-text-secondary">Menu</span>
  </a>
</nav>
