---
/**
 * GoogleReviews.astro
 * --------------------------------------------------------------------------
 * Displays curated 4–5 star Google reviews for the homepage.
 */
import SectionTitle from "./SectionTitle.astro";

const reviews = [
  {
    name: "Terry Hesticles",
    badge: "Local Guide",
    timeAgo: "a year ago",
    stars: 5,
    text: "Perfect for a neighborhood bar. Great service, airtight food, and great friends. 5's across the board.",
  },
  {
    name: "Rachael Awad",
    badge: "Local Guide",
    timeAgo: "2 years ago",
    stars: 5,
    text: "Groggs is a hidden gem of a pub! Its cozy atmosphere and friendly staff make it feel like a home away from home. The selection of craft beers and spirits is impressive, and the food menu offers delicious pub fare with a gourmet twist.",
  },
  {
    name: "James Nguyen",
    badge: "Local Guide",
    timeAgo: "4 years ago",
    stars: 5,
    text: "Their chicken tenders could bring peace in the middle east. Drinks and service also good.",
  },
  {
    name: "Rick Lehman",
    badge: "Local Guide",
    timeAgo: "11 months ago",
    stars: 5,
    text: "It's a great bar with better than average food. Bartenders are awesome and even when busy are very attentive and fast and friendly. Lots of TVs.",
  },
  {
    name: "Alex Aguallo",
    badge: "Local Guide",
    timeAgo: "6 years ago",
    stars: 5,
    text: "Very nice establishment! Real neighborhood bar vibe, a lot of regulars and witty banter from the bartenders — felt like I was in an episode of Cheers! Best bar in Clovis/Fresno!",
  },
  {
    name: "Brandon Chase",
    badge: "Local Guide",
    timeAgo: "7 years ago",
    stars: 5,
    text: "Food was great, the service was excellent and the live music on a Tuesday night was a pleasant surprise. I would definitely recommend this to anyone in the Clovis area!",
  },
  {
    name: "Jeanette Hinojosa",
    badge: "Local Guide",
    timeAgo: "2 years ago",
    stars: 5,
    text: "Even though the bartender was so busy, he did such a great job and treated us like princesses! A+. Karaoke night was fun!",
  },
  {
    name: "Richard Scroggin",
    badge: "Local Guide",
    timeAgo: "8 years ago",
    stars: 5,
    text: "Great local spot. Diamond in the rough for bar food. Incredible. The Philly cheese steak is amazing. Our favorite place to get drinks and take over the jukebox.",
  },
  {
    name: "Luis Parrales",
    badge: "Local Guide",
    timeAgo: "4 years ago",
    stars: 5,
    text: "Jameson on tap — need I say more? Really though, it's an amazing pub with good food and a great atmosphere. Their yearly St. Patrick's Day celebration is so much fun.",
  },
];
---

<section class="bg-wood-darker/50 border-y border-white/5 relative overflow-hidden">
  <!-- Background glow -->
  <div class="absolute left-0 top-0 w-1/3 h-full bg-pub-green/5 blur-3xl rounded-full -translate-x-1/2 -translate-y-1/4 pointer-events-none"></div>

  <div class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:px-12">
    <!-- Header row -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-12">
      <SectionTitle subtitle="What our guests are saying">
        Loved by Locals
      </SectionTitle>

      <!-- Google badge -->
      <a
        href="https://www.google.com/maps/search/Grogg's+Pub+Clovis"
        target="_blank"
        rel="noopener noreferrer"
        class="flex-shrink-0 flex items-center gap-3 bg-wood-dark border border-white/10 rounded-xl px-5 py-3 hover:border-pub-green/40 transition-colors group"
        aria-label="See all reviews on Google"
      >
        <!-- Google "G" SVG -->
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <div class="text-left">
          <div class="text-xs text-text-secondary font-body leading-none mb-1">Rated on</div>
          <div class="text-sm font-semibold text-text-primary leading-none">Google Reviews</div>
        </div>
        <div class="flex items-center gap-1 ml-2">
          <span class="text-amber-400 text-lg leading-none">&#9733;</span>
          <span class="text-sm font-bold text-text-primary">4.5</span>
        </div>
      </a>
    </div>

    <!-- Reviews grid -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {reviews.map((review) => (
        <article class="flex flex-col bg-wood-dark border border-white/8 rounded-xl p-6 shadow-lg hover:border-pub-green/30 transition-colors">
          <!-- Stars -->
          <div class="flex gap-0.5 mb-4" aria-label={`${review.stars} out of 5 stars`}>
            {Array.from({ length: review.stars }).map(() => (
              <span class="text-amber-400 text-lg leading-none" aria-hidden="true">&#9733;</span>
            ))}
          </div>

          <!-- Review text -->
          <p class="font-body text-text-secondary text-sm leading-relaxed flex-1 mb-5">
            "{review.text}"
          </p>

          <!-- Reviewer -->
          <div class="flex items-center gap-3 pt-4 border-t border-white/8">
            <!-- Avatar placeholder -->
            <div class="w-9 h-9 rounded-full bg-pub-green/20 border border-pub-green/30 flex items-center justify-center flex-shrink-0">
              <span class="text-pub-green font-semibold text-sm">{review.name.charAt(0)}</span>
            </div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-text-primary truncate">{review.name}</div>
              <div class="text-xs text-text-muted font-body">{review.badge} &middot; {review.timeAgo}</div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-10 text-center">
      <a
        href="https://www.google.com/maps/search/Grogg's+Pub+Clovis"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-body text-sm text-text-secondary hover:text-pub-green transition-colors"
      >
        See all reviews on Google
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M7 7h10v10"/>
        </svg>
      </a>
    </div>
  </div>
</section>
