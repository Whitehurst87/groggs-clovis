---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section
    class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 text-center"
  >
    <p
      class="text-pub-green-light display-caps text-sm tracking-[0.4em]"
    >
      Phase 0 — Bootstrap Complete
    </p>
    <h1 class="display-caps text-4xl sm:text-6xl">
      Grogg's Traditional Irish Pub
    </h1>
    <p class="text-text-secondary max-w-xl text-lg">
      Where Tradition Meets Modern Hospitality. The new groggsclovis.com is
      under construction — stay tuned.
    </p>
    <a
      href="#"
      class="bg-pub-green hover:bg-pub-green-dark inline-flex items-center justify-center rounded-sm px-8 py-3 font-semibold tracking-wider text-white uppercase transition-colors"
    >
      View Menu
    </a>
  </section>
</BaseLayout>
