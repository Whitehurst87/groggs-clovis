---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import SectionTitle from "../components/SectionTitle.astro";
import EventCalendar from "../components/react/EventCalendar";
import heroBg from "../assets/images/full bar happy patrons.webp";
import { getCollection } from "astro:content";
import { format, isSameMonth } from "date-fns";
import { generateEventSchema } from "../lib/schema";
import { generateICS } from "../lib/ics";
import { Calendar, MapPin, Clock, ExternalLink, Download } from "lucide-react";

const events = await getCollection("events");
const sortedEvents = events.sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
);

const now = new Date();
const thisMonthEvents = sortedEvents.filter((event) =>
  isSameMonth(event.data.date, now),
);
const upcomingEvents = sortedEvents.filter((event) => event.data.date >= now);

const eventSchemas = sortedEvents.map((event) => generateEventSchema(event));
---

<BaseLayout
  title="Events | Grogg's Traditional Irish Pub"
  description="Join us for Karaoke Wednesdays and catch all the live sports at Grogg's Clovis."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(eventSchemas)}
  />

  <section class="relative flex min-h-[40vh] flex-col items-center justify-center overflow-hidden px-6 py-20 text-center mb-10">
    <div class="absolute inset-0 z-0">
      <Image
        src={heroBg}
        alt="Full bar with happy patrons"
        class="h-full w-full object-cover brightness-[0.4]"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-wood-darker/70 via-transparent to-wood-darker"></div>
    </div>
    <div class="relative z-10 flex flex-col items-center gap-6 max-w-3xl">
      <p class="display-caps text-[#f5f82f] text-sm tracking-[0.5em]">What's happening at the pub</p>
      <h1 class="font-alternate uppercase tracking-wide text-5xl sm:text-6xl text-[#f5f82f] leading-[1.1] drop-shadow-2xl">Upcoming Events</h1>
    </div>
  </section>

  <div class="pb-16 px-4 max-w-7xl mx-auto">

    <div class="grid lg:grid-cols-3 gap-12 mt-16">
      <div class="lg:col-span-2">
        <EventCalendar
          client:load
          events={sortedEvents.map((e) => ({
            title: e.data.title,
            date: e.data.date,
            recurrence: e.data.recurrence,
          }))}
        />
      </div>

      <div class="space-y-10">
        <div>
          <h3
            class="display-caps text-xl text-text-primary mb-6 border-b border-pub-green/30 pb-2"
          >
            Featured This Month
          </h3>

          <div class="space-y-6">
            {
              thisMonthEvents.map((event) => (
                <div class="bg-wood-darker p-6 border border-pub-green/20 rounded-lg group hover:border-pub-green/50 transition-colors shadow-lg">
                  <h4 class="text-xl font-cinzel text-pub-green mb-3 uppercase tracking-wide">
                    {event.data.title}
                  </h4>
                  <div class="space-y-2 text-sm text-text-secondary mb-4">
                    <div class="flex items-center gap-2">
                      <Calendar size={14} class="text-pub-green" />
                      <span>{format(event.data.date, "EEEE, MMMM do")}</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <Clock size={14} class="text-pub-green" />
                      <span>
                        {format(event.data.date, "h:mm a")}
                        {event.data.recurrence ? ` (${event.data.recurrence})` : ""}
                      </span>
                    </div>
                    <div class="flex items-center gap-2">
                      <MapPin size={14} class="text-pub-green" />
                      <span>
                        {event.data.location || "Grogg's Traditional Irish Pub"}
                      </span>
                    </div>
                  </div>
                  <p class="text-text-secondary text-sm mb-6 line-clamp-3 leading-relaxed">
                    {event.data.description}
                  </p>

                  <div class="flex flex-wrap gap-4 pt-4 border-t border-white/5">
                    <a
                      href={generateICS({
                        title: event.data.title,
                        date: event.data.date,
                        description: event.data.description,
                      })}
                      download={`${event.data.title.toLowerCase().replace(/\s+/g, "-")}.ics`}
                      class="text-[10px] font-bold uppercase tracking-widest text-text-primary hover:text-pub-green transition-colors flex items-center gap-1.5"
                    >
                      <Download size={12} />
                      Add to Calendar
                    </a>
                    {event.data.eventbriteUrl && (
                      <a
                        href={event.data.eventbriteUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[10px] font-bold uppercase tracking-widest text-pub-green hover:text-pub-green-light transition-colors flex items-center gap-1.5"
                      >
                        <ExternalLink size={12} />
                        Tickets & Info
                      </a>
                    )}
                  </div>
                </div>
              ))
            }

            {
              thisMonthEvents.length === 0 && (
                <p class="text-text-muted italic text-sm text-center py-8">
                  No featured events for the rest of this month. Check back soon!
                </p>
              )
            }
          </div>
        </div>

        <div class="bg-pub-green/5 p-8 rounded-lg border border-pub-green/10">
          <h3 class="display-caps text-lg text-text-primary mb-4">
            Private Events
          </h3>
          <p class="text-text-secondary text-sm mb-6 leading-relaxed">
            Planning a celebration, corporate event, or holiday party? We offer
            full catering and private space options.
          </p>
          <a
            href="/catering"
            class="inline-block bg-pub-green text-white px-6 py-3 text-xs font-bold uppercase tracking-widest hover:bg-pub-green-light transition-all shadow-md"
          >
            Inquire Now
          </a>
        </div>
      </div>
    </div>

    <div class="mt-32">
      <SectionTitle>All Upcoming</SectionTitle>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mt-16">
        {
          upcomingEvents.map((event) => (
            <div class="bg-wood-dark border border-white/5 rounded-lg overflow-hidden flex flex-col group hover:border-pub-green/30 transition-all duration-300">
              {event.data.image && (
                <div class="h-56 overflow-hidden">
                  <img
                    src={event.data.image}
                    alt={event.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  />
                </div>
              )}
              <div class="p-8 flex-grow flex flex-col">
                <div class="text-pub-green text-[10px] font-bold uppercase tracking-widest mb-3">
                  {format(event.data.date, "MMMM d, yyyy")}
                </div>
                <h3 class="text-xl font-cinzel text-text-primary uppercase mb-4 leading-tight group-hover:text-pub-green transition-colors">
                  {event.data.title}
                </h3>
                <p class="text-text-secondary text-sm mb-8 leading-relaxed line-clamp-4 flex-grow">
                  {event.data.description}
                </p>
                <div class="pt-6 border-t border-white/5">
                  <a
                    href={generateICS({
                      title: event.data.title,
                      date: event.data.date,
                      description: event.data.description,
                    })}
                    download={`${event.data.title.toLowerCase().replace(/\s+/g, "-")}.ics`}
                    class="text-[10px] font-bold uppercase tracking-widest text-pub-green hover:text-white transition-colors flex items-center gap-2"
                  >
                    <Download size={14} />
                    Add to Calendar
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
